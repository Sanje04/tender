# Production values for running the backend via docker-compose.yml on the
# self-hosted deployment target. Copy to backend/.env.production and fill in
# real values -- never commit the filled-in file.

# host.docker.internal lets the backend container reach Ollama running on the
# same host machine (outside Docker). Requires docker-compose.yml's
# extra_hosts entry on Linux; works out of the box on Docker Desktop.
#
# On Azure (AZURE_DEPLOYMENT.md) there is no such host: Ollama stays on the home
# machine and is reached over a Tailscale tunnel, so this becomes its MagicDNS
# name, e.g. http://ollama-host.your-tailnet.ts.net:11434. Note the tunnel is
# what resolves that name -- see the HTTP_PROXY block below.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest

# MongoDB Atlas free-tier connection string (see DEPLOYMENT.md step 1).
# To test against a local mongod instead, use
# mongodb://host.docker.internal:27017 -- and if that mongod runs as a replica
# set, append /?directConnection=true, or the driver discards the seed host for
# the replica set's advertised 127.0.0.1, unreachable from inside a container.
# Never add directConnection to the mongodb+srv:// string below: it is
# incompatible with SRV/multi-host seedlists.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ag_ai

# Fail fast on an unreachable database rather than hanging for the driver's
# 30s default. Raise it if Atlas cold-starts are being clipped.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Number of most-recent conversation turns (user+assistant message pairs)
# replayed to the model as context on each /api/chat call. 0 disables history.
MAX_HISTORY_TURNS=5

# Stays false even in production: Cloudflare Tunnel terminates TLS at its edge
# and forwards plain HTTP to this container. Setting this to true would make
# the backend redirect its own internal HTTP traffic and break the tunnel.
# Same reasoning applies on Azure Container Apps, where ingress terminates TLS
# and forwards plain HTTP -- see AZURE_DEPLOYMENT.md.
FORCE_HTTPS=false

# Comma-separated CORS origins. nginx proxies /api/ to the backend, so browser
# traffic is same-origin and this only needs the one public frontend hostname --
# not "*". On Azure that is the frontend container app's FQDN, which only exists
# after the frontend is deployed, so this is set last (AZURE_DEPLOYMENT.md step 9).
ALLOWED_ORIGINS=https://your-frontend-hostname.example.com

# --- MCP tool server (specs.md Phase 8) -------------------------------------
# docker-compose.yml gives this same file to both the `backend` and `mcp`
# services, so these three keys are read by whichever process needs them.

# How the backend container reaches the mcp container: compose service name, not
# host.docker.internal (both are inside the same compose network). This matches
# the built-in default, so it could be omitted -- it's spelled out here so the
# topology is visible in the config rather than only in code.
MCP_SERVER_URL=http://mcp:9000/mcp

# 0.0.0.0, not 127.0.0.1: the mcp container must accept connections from the
# backend container. Safe because docker-compose.yml `expose`s (not
# `ports:`-publishes) 9000, so only the compose network can reach it.
MCP_HOST=0.0.0.0
MCP_PORT=9000

# --- Tailscale tunnel to the home Ollama host (AZURE_DEPLOYMENT.md) ----------
# Only needed when Ollama is not reachable from wherever the backend runs. The
# plain docker-compose deployment in DEPLOYMENT.md uses host.docker.internal and
# should leave this entire block commented out.
#
# How it works, and why it needs no application code: agent.py talks to Ollama
# through a bare httpx.AsyncClient(), and httpx honours proxy environment
# variables by default. Setting HTTP_PROXY therefore routes Ollama traffic
# through the tailscaled sidecar and onto the tailnet without agent.py knowing a
# tunnel exists. tailscaled also does the DNS itself, so the backend container
# never has to resolve a .ts.net name -- only the proxy does.
#
# NO_PROXY is not optional. Without it the same HTTP_PROXY would swallow the
# backend's MCP calls, which are also plain HTTP, and send them down the tunnel
# looking for a tool server that is not there. Tool discovery would fail soft
# (chat would answer with no tools -- see specs.md Phase 8), so this misconfigures
# silently rather than loudly, which is exactly why it is spelled out here.
# MongoDB is unaffected either way: Motor does not read proxy variables.
#
# The host differs by platform, and it is the only value that does:
#   docker compose --profile tailnet  ->  http://tailscale:1055  (separate
#       containers, so the compose service name)
#   Azure Container Apps              ->  http://localhost:1055  (sidecar in the
#       same replica, sharing one network namespace)
# NO_PROXY must list every internal host the backend must reach directly: the
# `mcp` compose service, or *.azurecontainerapps.io on Azure.
#HTTP_PROXY=http://tailscale:1055
#NO_PROXY=mcp,localhost,127.0.0.1,.azurecontainerapps.io

# Tailscale OAuth client (admin console -> Settings -> OAuth clients), scoped to
# the auth_keys write scope and the tag in docker-compose.yml's
# --advertise-tags. An OAuth client rather than a plain auth key because auth
# keys expire within 90 days and would silently take the deployment down; OAuth
# client secrets do not expire, and nodes registered with one are ephemeral by
# default, so a restarted container does not leave a dead node behind.
# Treat the secret like any other credential -- never commit the filled-in file.
#TS_CLIENT_ID=
#TS_CLIENT_SECRET=

# --- Logging & metrics (observability.py, specs.md Phase 10) -----------------
# Both defaults are already the right ones for a deployment, so these are listed
# for discoverability rather than because they need setting. JSON on stdout is
# what a container log collector can parse; set LOG_FORMAT=text only when
# tailing by eye. Metrics are at GET /metrics, which is not proxied by nginx and
# so is not reachable from the public frontend hostname.
LOG_LEVEL=INFO
LOG_FORMAT=json
