# Base URL of the Ollama server (can be on another machine on your LAN).
OLLAMA_BASE_URL=http://10.0.0.68:11434

# Model name as shown by `ollama list` on the Ollama machine.
OLLAMA_MODEL=llama3.1:8b

# Local MongoDB instance used to persist conversation history.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ag_ai

# Number of most-recent conversation turns (user+assistant message pairs)
# replayed to the model as context on each /api/chat call. 0 disables history.
MAX_HISTORY_TURNS=5

# Set to "true" only behind a real deployment with TLS termination (reverse
# proxy/load balancer). Leave unset/false for local HTTP dev.
FORCE_HTTPS=false

# Whether POST /api/transactions/import is served at all. True here because
# importing a CSV is how you get data in locally. Set it to false on any public
# hostname: the endpoint is unauthenticated and replaces all account/transaction
# data outright, and it can't be secured with a header because the caller is the
# browser. A public deployment seeds its data once with
# scripts/seed_transactions.py instead -- see AZURE_DEPLOYMENT.md step 5.
IMPORT_ENABLED=true

# Comma-separated list of origins CORS allows. "*" for local dev, where the Vite
# dev server is on a different port and therefore cross-origin. In a deployment
# where nginx proxies /api/ to this backend (see ui/nginx.conf.template),
# same-origin, so pin this to the single frontend hostname instead.
ALLOWED_ORIGINS=*

# --- MCP tool server (specs.md Phase 8) -------------------------------------
# The agent's six tools now live in a second process (backend/mcp_server.py).
# Start it alongside the API with:
#   .\.venv\Scripts\python.exe mcp_server.py

# The one variable the backend reads to find that server. Unset/empty falls back
# to http://mcp:9000/mcp (docker-compose.yml's service name), so only local dev
# outside Docker needs to set it. If the server is unreachable the backend still
# serves -- chat just runs with no tools.
MCP_SERVER_URL=http://127.0.0.1:9000/mcp

# Interface/port mcp_server.py binds. 127.0.0.1 for local dev; the Docker image
# overrides nothing, so set MCP_HOST=0.0.0.0 in .env.production for compose.
MCP_HOST=127.0.0.1
MCP_PORT=9000

# How long the Mongo driver waits to find a reachable server before failing a
# request. Default 5000ms -- the driver's own default is 30s, which makes an
# unreachable database look like a hang instead of an error.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Logging & metrics (observability.py) -----------------------------------
# Root log level for both processes.
LOG_LEVEL=INFO

# "json" (default) emits one JSON object per line, which is what a container log
# collector can parse. Set to "text" for a human-readable local dev server.
LOG_FORMAT=json
