# Rendered to /etc/nginx/conf.d/default.conf at container start by nginx:alpine's
# built-in envsubst step (see ui/Dockerfile). It is a template, not a static
# config, because the backend's address is not knowable at image build time:
# under docker-compose it is the `backend` service name, on Azure Container Apps
# it is an ingress FQDN containing a per-environment hash
# (backend.internal.<env-domain>) -- see AZURE_DEPLOYMENT.md.
#
# Substitution is restricted to BACKEND_ORIGIN and NGINX_LOCAL_RESOLVERS by the
# Dockerfile's NGINX_ENVSUBST_FILTER, so nginx's own runtime variables (host,
# remote_addr, request_uri and friends) survive into the rendered config
# untouched instead of being blanked out.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # nginx resolves names in a static proxy_pass once, at config load, and
        # refuses to start if the name does not resolve yet. The backend
        # container app may legitimately be scaled to zero at that moment, so
        # the upstream goes through a variable instead, which defers resolution
        # to request time -- and a variable upstream requires an explicit
        # resolver. The value comes from the base image's local-resolvers
        # entrypoint script (see the Dockerfile), which reads this container's
        # own /etc/resolv.conf, so it is correct on Docker and on Azure without
        # either being hardcoded here.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        resolver_timeout 5s;

        set $backend_origin "${BACKEND_ORIGIN}";

        # $request_uri, not a rewritten path: with a variable in proxy_pass nginx
        # ignores any URI part written here, so the full original path (/api/...)
        # is forwarded explicitly. The old static form was `proxy_pass
        # http://backend:8000/api/` under `location /api/`, which stripped and
        # re-added the same prefix -- an identity mapping, so nothing changes.
        proxy_pass $backend_origin$request_uri;

        # $proxy_host (the host from proxy_pass), not $host (the host the browser
        # asked for). Azure Container Apps routes internal ingress by Host header,
        # so forwarding the frontend's own hostname makes the internal edge look up
        # an app that does not exist and answer 404 -- Azure's "Container App is
        # stopped or does not exist" page, served while the backend is running and
        # healthy, which points the blame at the wrong container. Verified from
        # inside the environment: same URL, Host=backend -> 200, Host=frontend -> 404.
        # Under docker-compose this is backend:8000 and uvicorn ignores it either
        # way, so the two topologies stay on one config. It is also nginx's own
        # default for this header -- the previous line was overriding it.
        proxy_set_header Host $proxy_host;
        # The public hostname the browser used, preserved separately now that Host
        # names the upstream.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A cold Ollama model load (multi-GB) plus real inference can exceed
        # nginx's default 60s timeout, cutting the request before the backend
        # itself would even give up (see agent.py's own httpx timeout).
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
